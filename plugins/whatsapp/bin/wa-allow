#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# ///
"""Manage the WhatsApp chat allowlist, shared by every machine through your notification chat
(or your self-chat if you have none).

  wa-allow list [search]       chats this machine has seen, latest first; * allowlisted, ⏳ pending
                               names. search: part of a chat or contact name, a number, or a JID
  wa-allow add <chat>          allowlist a chat (name, part of a name, number or JID)
  wa-allow remove <chat>       stop capturing and sending to a chat
  wa-allow direct on|off       allowlist all 1:1 chats
  wa-allow notify <name|jid>   make a group a notification chat: Claude's messages to it send without
                               asking while only you (and at most one other account) are in it; asks
                               for Touch ID here
  wa-allow unnotify <name|jid> stop that (the chat stays allowlisted)

add/remove/direct/notify post "#wa <command>" through the local bridge to your
notification chat (else your "Message yourself" chat), so every linked machine
applies it. The same commands can be typed in either chat on your phone. Adding a chat fetches its last 50 messages from your phone.

<chat> is found as in wa-send: an exact name wins, else every word typed starts a word of the name;
one match is posted as its JID, several are listed and nothing is done, none posts the name as typed
(it waits as a pending name until a chat with it appears). ADR 2026-10-30-7e2c9d.
"""
import json
import os
import sys
import urllib.error
import urllib.request

from walookup import HOME, find, people, resolve

CONFIG = os.path.join(HOME, "config.json")


def load():
    try:
        with open(CONFIG) as f:
            return json.load(f)
    except FileNotFoundError:
        return {"allow_chats": [], "allow_direct_chats": False, "port": 8080}


def command(text):
    """Post an allowlist command through the bridge (POST /api/command)."""
    cfg = load()
    try:
        with open(os.path.join(HOME, "token")) as f:
            token = f.read().strip()
    except OSError:
        sys.exit("No bridge token: is the bridge set up? (install.sh status)")
    req = urllib.request.Request(
        f"http://127.0.0.1:{cfg.get('port') or 8080}/api/command",
        data=json.dumps({"command": text}).encode(),
        headers={"Authorization": f"Bearer {token}", "Content-Type": "application/json"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=180) as r:  # notify waits for Touch ID
            body = json.load(r)
    except urllib.error.HTTPError as e:
        body = json.loads(e.read() or b"{}")
        sys.exit(f"refused: {body.get('message', e.reason)}")
    except urllib.error.URLError as e:
        sys.exit(f"bridge not reachable ({e.reason}); start it with install.sh service")
    meaning = {
        "applied": "applied",
        "pending": "pending: no chat with that name seen yet on this machine; applies when it appears",
        "ambiguous": "not applied: several chats have that name; pass the JID (wa-allow list <name>)",
        "duplicate": "already applied",
        "invalid": "not applied: a notification chat must be a group this machine has seen",
    }
    print(f"{text}: {meaning.get(body.get('result'), body.get('result'))} here; {body.get('message', '')}")


def chats(search=""):
    """People with chats (all, or those search finds, contacts without a chat included), latest first."""
    if not os.path.exists(os.path.join(HOME, "messages.db")):
        sys.exit("No chats yet: is the bridge paired and running? (install.sh status)")
    everyone = people()
    if not search:
        return sorted((p for p in everyone if p.chats), key=lambda p: p.last, reverse=True)
    if "@" in search:
        return [p for p in everyone if any(search in jid for _, jid in p.chats) or search in p.key]
    return find(search, everyone, broad=True)


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return
    cmd, args = argv[0], argv[1:]
    cfg = load()
    allowed = set(cfg.get("allow_chats", []))
    if cmd == "list":
        for p in chats(" ".join(args)):
            mark = "*" if any(jid in allowed for _, jid in p.chats) else " "
            print(f"{mark} {p.last[:16] or '-':16}  {p.label[:48]:48}  {p.jid}")
        for jid in cfg.get("notify_chats", []):
            print(f"🔔 notification chat: {jid}")
        for name in cfg.get("allow_names", []):
            print(f"⏳ pending name: {name}")
    elif cmd in ("add", "remove", "notify", "unnotify") and args:
        target = " ".join(args)
        command(f"{cmd} {resolve(target, missing_ok=True) or target}")
    elif cmd == "direct" and args and args[0] in ("on", "off"):
        command(f"direct {args[0]}")
    else:
        sys.exit(__doc__.strip())


if __name__ == "__main__":
    main(sys.argv[1:])
